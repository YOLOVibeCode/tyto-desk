# Supply chain (docs/IMPLEMENTATION.md §2), as in the repo's own .npmrc. This directory is an npm project of its own,
# not a workspace, so npm reads this file here and never the root's: no install script runs (agent-browser's postinstall
# would relink a global agent-browser to this copy), and every pin npm saves is exact. lint:install-scripts checks both.
ignore-scripts=true
save-exact=true
fund=false
